<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "Usage access": lets the app read how much space other apps use. Read-only. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Android 11+ package visibility: needed to list every installed app. Sideloaded app, not on Play. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- "All files access" (Android 11+): lets the app find files anywhere on shared storage and move them
         into its own trash folder. Never used for anything else. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Downloads the signed malware signature list from one fixed GitHub address, over HTTPS only.
         The only networking code is net/SignatureDownloader.kt; .github/scripts/check-network.sh enforces that. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the Malware check open Android's own "Uninstall this app?" dialog (Intent.ACTION_DELETE). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Lets the APK list hand a tapped .apk to Android's package installer (it asks the user to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 13+: lets the scheduled malware scan show its short summary notification. Asked for when the
         schedule is turned on; the scan runs without it and shows its result on the Malware screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets a scheduled scan survive a restart of the phone: the system refuses persisted jobs without it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the scheduled scan ask whether the phone is on Wi-Fi before it updates the malware lists. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 8-10 equivalent of "All files access". -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sweeper">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Gives the app the user picked in "Open with" read-only access to ONE tapped file. Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Runs the scheduled malware scan while the phone charges. Only the system can bind to it. -->
        <service
            android:name=".scan.ScheduledScanService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
